taplabel,,,,,Click me,,Direct clicks 0 -> 1,gtk
sleep,,,,,,600000,,gtk
taplabel,,,,,Click me too,,Covered clicks 0 -> 1 through the transparent overlay,gtk
sleep,,,,,,600000,,gtk
taplabel,,,,,Hidden button,,Hidden clicks 0 -> 1 through the opaque allowsHitTesting(false) overlay,gtk
