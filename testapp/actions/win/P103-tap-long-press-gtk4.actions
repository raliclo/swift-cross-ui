# P103 on Windows GtkBackend (TEST_BACKEND=gtk4): the steps of actions/win/P103-tap-long-press.actions. The GTK
# window is not scaled; positions read off the capture of 2026-10-19: row emoji at x 57, 停車場 y 263, 便利商店 y 307;
# SOLO emoji (92, 462).
# Pass (p103-emoji.log): ROW 停車場 off, then SOLO on; ROW 便利商店 picker and NO ROW 便利商店 off for the long press.
# P103(Windows GTK):點停車場→off,點 SOLO→on,長按便利商店→開 picker 且不得記為點擊。
sleep,,,,,,1500000,let P103 lay out,windows
click,57,263,frame,left,,,停車場: a tap switches it off,windows
sleep,,,,,,800000,,windows
click,92,462,frame,left,,,SOLO: a tap switches it on,windows
sleep,,,,,,800000,,windows
mousedown,57,307,frame,left,,,便利商店: press,windows
sleep,,,,,,900000,held 0.9 s -- past the 0.5 s long-press delay; the picker opens,windows
mouseup,,,,left,,,let go in place -- no toggle may be logged,windows
sleep,,,,,,1500000,leave the picker open for the final capture,windows
