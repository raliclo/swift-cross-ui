action,x,y,origin,button,key,micros,note,platform
# P60 on Android: open settings as a sheet, then increment from inside it.
# Pass: a sheet titled "P60 settings" over the window, and after "+1" its count
# reads 1. The main window's count, read after the sheet is dismissed, is the
# shared-state half of the check; the capture shows the sheet.
# taplabel since 2026-10-22. The clicks used to be phone points (px / 2.625,
# measured 2026-10-01 on swift-cross-ui-api36b) and missed on
# swift-cross-ui-tablet36; a label is found on either screen.
# 自 2026-10-22 起改用 taplabel:原本的點擊是手機座標，在平板 AVD 上點空。
# P60 在 Android 上:以 sheet 開啟設定，再在其中按 +1。通過:sheet 出現，其中 count 讀 1。
sleep,,,,,,1500000,let P60 lay out,android
taplabel,,,,,open settings,,open settings -- expect a sheet over this window,android
sleep,,,,,,2000000,let the sheet present,android
taplabel,,,,,+1,,+1 inside settings -- its count must read 1,android
sleep,,,,,,800000,let the count redraw,android
