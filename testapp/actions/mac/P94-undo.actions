action,x,y,origin,button,key,micros,note,platform
# P94 on macOS (AppKitBackend): a TextEditor undoes one change at a time.
#   zsh testapp/test.zsh P94 --macos --actionfile testapp/actions/mac/P94-undo.actions
# The editor starts as "hello". Keys only. The clipboard is used: it ends holding "hello".
# Expected "editor" lines in p94-undo.log, in order (an empty one is "editor "):
#   "" hello hellohello | hello "" hello | "" hello
# The fourth Undo has nothing left and must add no line; the two Redos give the last two.
# Until 2026-10-14 the synthesiser built its key events with NSEvent.keyEvent, and a
# synthesised Shift-Command-Z did not reach Edit > Redo (queue item 14); a Command chord is
# built from a CGEvent now.
# macOS(AppKitBackend)上的 P94:TextEditor 一次復原一個變更。編輯器起始為 hello;只用按鍵;會用到剪貼簿，結束時
# 內容是 hello。p94-undo.log 的 editor 各行應依序如上;第四次 Undo 不得多出一行，兩次 Redo 給出最後兩行。
# 2026-10-14 之前合成器以 NSEvent.keyEvent 建立按鍵事件，合成的 Shift-Command-Z 到不了 Edit > Redo
# (queue 第 14 項);現在 Command 組合鍵改由 CGEvent 建立。
sleep,,,,,,1500000,let the window settle,macos
click,160,200,frame,left,,,the text editor,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,a,,select all,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,x,,cut -- editor is empty,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,v,,paste -- hello,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,v,,paste again -- hellohello,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
sleep,,,,,,800000,,macos
keydown,,,,,command,,,macos
key,,,,,z,,undo 1 -- hello: one paste only,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,z,,undo 2 -- empty,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,z,,undo 3 -- the first hello,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
key,,,,,z,,undo 4 -- nothing left; no change,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
keydown,,,,,shift,,,macos
key,,,,,z,,redo 1 -- empty,macos
keyup,,,,,shift,,,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
keydown,,,,,command,,,macos
keydown,,,,,shift,,,macos
key,,,,,z,,redo 2 -- hello; left on screen for the capture,macos
keyup,,,,,shift,,,macos
keyup,,,,,command,,,macos
sleep,,,,,,500000,,macos
sleep,,,,,,500000,,macos
