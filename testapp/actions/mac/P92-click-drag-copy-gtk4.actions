sleep,,,,,,30000,,macos
move,116,167,frame,,,,drag right,macos
sleep,,,,,,30000,,macos
move,121,167,frame,,,,drag right,macos
sleep,,,,,,30000,,macos
mouseup,121,167,frame,left,,,let go past the end: hello selected,macos
sleep,,,,,,300000,,macos
keydown,,,,,command,,,macos
key,,,,,c,,copy hello,macos
