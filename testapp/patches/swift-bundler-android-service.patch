+    // Drop `.swift_ast` from the library that ships.
+    //
+    // It is the serialized Swift AST that lldb reads to describe types in a
+    // debugger session, and nothing at runtime touches it. Measured on this
+    // tree 2026-09-04 with `llvm-size --format=sysv` over a packaged
+    // `libP43.so`: 137.6 MB total, of which `.text` was 56.7 and `.swift_ast`
+    // was 45.0 -- a third of the library, and the second largest section in it.
+    // Removing it took the library from 130.3 MB to 87.3 and the APK from 212
+    // to 169, a fifth of the download, with no functional change.
+    //
+    // After the copy rather than before, so the build tree keeps its debugging
+    // information and only the packaged copy loses it. Building with `-gnone`
+    // would drop the section at the source and take local debuggability with
+    // it.
+    //
+    // Not fatal if the tool is missing: the APK is correct either way, just
+    // larger. It says so rather than passing over it, because a size
+    // optimisation that silently stops working is one nobody notices until the
+    // download doubles.
+    // Kept when asked. `SCUI_KEEP_SWIFT_AST=1` leaves the section in, for a
+    // build that is going to be attached to with lldb: the debugger reads
+    // `.swift_ast` to describe types, and stripping it is what makes a
+    // packaged build unhelpful to step through. The default is to strip,
+    // because the common case is an APK to install and measure.
+    //
+    // 需要時保留。`SCUI_KEEP_SWIFT_AST=1` 會把該 section 留著，供「將以 lldb 附加」的建置使用：
+    // debugger 是靠讀取 `.swift_ast` 來描述型別的，而剝除它，正是讓一個已打包的建置難以逐步追蹤
+    // 的原因。預設為剝除，因為常見情況是「要安裝並量測的 APK」。
+    let keepAST = ProcessInfo.processInfo.environment["SCUI_KEEP_SWIFT_AST"]
+      .map { $0 == "1" || $0 == "true" } ?? false
+
+    if keepAST {
+      log.info("SCUI_KEEP_SWIFT_AST is set; leaving .swift_ast in the packaged library")
+    }
+
+    let objcopyTool = try Error.catch {
+      try AndroidSDKManager.llvmPrebuiltDirectory(
+        forNDK: ndk,
+        hostPlatform: .hostPlatform,
+        hostArchitecture: .host
+      )
+    } / "bin/llvm-objcopy"
+    if !keepAST, FileManager.default.fileExists(atPath: objcopyTool.path) {
+      let strip = Process.create(
+        objcopyTool.path,
+        arguments: ["--remove-section=.swift_ast", libraryDestination.path],
+        runSilentlyWhenNotVerbose: true
+      )
+      do {
+        try await strip.runAndWait()
+      } catch {
+        log.warning("Could not remove .swift_ast from the packaged library: \(error)")
+      }
+    } else if !keepAST {
+      log.warning("llvm-objcopy not found in the NDK; the packaged library keeps its .swift_ast section")
+    }
