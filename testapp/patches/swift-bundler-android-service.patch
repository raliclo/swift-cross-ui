+  /// A `<service>`, which is how a window outlives the activity that made it.
+  ///
+  /// `windowLevel(.floating)` on Android is a `TYPE_APPLICATION_OVERLAY`
+  /// window, and an overlay owned by an activity is hidden the moment that
+  /// activity stops -- measured 2026-09-04, with `dumpsys` reporting
+  /// `Surface: shown=false mLastHidden=true` while the view was still VISIBLE
+  /// and HAS_DRAWN, and the process listed as `prev /LAST`. A foreground
+  /// service is what keeps the process out of the cached state and the surface
+  /// on screen.
+  ///
+  /// `foregroundServiceType` is required from API 34; the system refuses to
+  /// start the service without it.
+  struct Service: Codable {
+    @Attribute var name: String?
+    @Attribute var exported: Bool?
+    @Attribute var foregroundServiceType: String?
+
+    enum CodingKeys: String, CodingKey {
+      case name = "android:name"
+      case exported = "android:exported"
+      case foregroundServiceType = "android:foregroundServiceType"
+    }
+
+    init(
+      name: String? = nil,
+      exported: Bool? = nil,
+      foregroundServiceType: String? = nil
+    ) {
+      _name = Attribute(name)
+      _exported = Attribute(exported)
+      _foregroundServiceType = Attribute(foregroundServiceType)
+    }
+  }
